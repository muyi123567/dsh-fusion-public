{
  "name": "@dsh-fusion/host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./standalone": {
      "types": "./dist/standalone.d.ts",
      "default": "./dist/standalone.js"
    }
  },
  "scripts": {
    "typecheck": "pnpm exec tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && pnpm exec tsc -p tsconfig.json"
  },
  "dependencies": {
    "@dsh-fusion/config": "workspace:*",
    "@dsh-fusion/core": "workspace:*",
    "fastify": "^5.4.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "4.1.12"
  }
}
