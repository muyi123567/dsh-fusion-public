{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/muyi123567/dsh-fusion-public/docs/design/contracts/preset-backup.v1.schema.json",
  "title": "Whale preset and backup v1",
  "oneOf": [
    { "$ref": "#/$defs/preset" },
    { "$ref": "#/$defs/backup" }
  ],
  "$defs": {
    "preset": {
      "type": "object",
      "required": ["id", "kind", "title", "description", "tags"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
        "kind": { "enum": ["skill", "config", "plugins"] },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "tags": { "type": "array", "items": { "type": "string" } },
        "status": {
          "type": "object",
          "required": ["state"],
          "properties": {
            "state": { "enum": ["installed", "not-installed", "modified"] },
            "path": { "type": "string" },
            "installedAt": { "type": "string", "format": "date-time" }
          },
          "additionalProperties": false
        },
        "plugins": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "spec", "why"],
            "properties": {
              "name": { "type": "string" },
              "spec": { "type": "string" },
              "why": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    },
    "backup": {
      "type": "object",
      "required": ["version", "id", "createdAt", "reason", "files", "skipped"],
      "properties": {
        "version": { "const": 1 },
        "id": { "type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "reason": { "type": "string", "minLength": 1 },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source", "path", "sha256", "bytes", "mode"],
            "properties": {
              "source": { "type": "string" },
              "path": { "type": "string" },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "bytes": { "type": "number", "minimum": 0 },
              "mode": { "type": "number", "minimum": 0, "maximum": 511 }
            },
            "additionalProperties": false
          }
        },
        "skipped": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source", "path", "reason"],
            "properties": {
              "source": { "type": "string" },
              "path": { "type": "string" },
              "reason": { "enum": ["denied-name", "missing", "symlink", "not-file", "too-large", "total-too-large"] }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
