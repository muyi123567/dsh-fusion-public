{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/muyi123567/dsh-fusion-public/contracts/fleet-manifest.v1.schema.json",
  "title": "FleetHostManifest v1",
  "description": "One DSH host's public, signed environment facts. Never contains secrets, tokens, private keys, full commands, or raw user paths.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "hostId",
    "displayName",
    "observedAt",
    "dsh",
    "bundles",
    "patches",
    "capabilities",
    "workspaces",
    "providers",
    "mcpServers",
    "secrets",
    "environmentDigest",
    "signature"
  ],
  "properties": {
    "contractVersion": { "const": 1 },
    "hostId": { "$ref": "#/$defs/hostId" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 128 },
    "observedAt": { "type": "string", "format": "date-time" },
    "staleAfterSeconds": { "type": "integer", "minimum": 30, "maximum": 86400 },
    "dsh": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "profile", "node", "platform", "arch"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "profile": { "type": "string", "minLength": 1 },
        "node": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "platform": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 }
      }
    },
    "bundles": {
      "type": "array",
      "items": { "$ref": "#/$defs/bundle" }
    },
    "patches": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "home"],
      "properties": {
        "profile": { "$ref": "#/$defs/patchRef" },
        "home": { "$ref": "#/$defs/patchRef" },
        "lock": { "$ref": "#/$defs/patchRef" }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exemptions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "description": "Presence/enum facts only; no probing calls with side effects.",
      "additionalProperties": { "type": ["boolean", "string", "number"] }
    },
    "workspaces": {
      "type": "array",
      "items": { "$ref": "#/$defs/workspace" }
    },
    "providers": {
      "type": "array",
      "description": "Model provider names only.",
      "items": { "type": "string", "minLength": 1 }
    },
    "mcpServers": {
      "type": "array",
      "items": { "$ref": "#/$defs/mcpServer" }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present"],
      "properties": {
        "present": {
          "type": "array",
          "description": "Credential names whose presence was observed. Values are never included.",
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$" }
        }
      }
    },
    "environmentDigest": { "$ref": "#/$defs/sha256" },
    "secretPresenceDigest": { "$ref": "#/$defs/sha256" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "hostId": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "enabled", "availability"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "enabled": { "type": "boolean" },
        "installed": { "type": "boolean" },
        "availability": { "enum": ["installation", "profile", "missing"] },
        "official": { "type": "boolean" },
        "optional": { "type": "boolean" },
        "source": { "type": "string" },
        "rows": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "overrides": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "patchRef": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["sha256", "bytes"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rootHash", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "rootHash": { "$ref": "#/$defs/sha256" },
        "vcsCommit": { "type": ["string", "null"], "pattern": "^[a-f0-9]{40}$" },
        "dirty": { "type": ["boolean", "null"] },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "mcpServer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "transport"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "transport": { "enum": ["stdio", "streamable-http"] },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "keyId", "value"],
      "properties": {
        "alg": { "const": "ed25519" },
        "keyId": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$" }
      }
    }
  }
}
