{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/muyi123567/dsh-fusion-public/docs/design/contracts/cloud-connector.v1.schema.json",
  "title": "Whale cloud connector v1",
  "oneOf": [
    { "$ref": "#/$defs/definition" },
    { "$ref": "#/$defs/instance" },
    { "$ref": "#/$defs/entry" },
    { "$ref": "#/$defs/pullReceipt" }
  ],
  "$defs": {
    "kind": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}(/[a-z0-9][a-z0-9._-]{0,63})?$"
    },
    "capabilities": {
      "type": "object",
      "required": ["list", "stat", "pull", "upload"],
      "properties": {
        "list": { "type": "boolean" },
        "stat": { "type": "boolean" },
        "pull": { "type": "boolean" },
        "upload": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "field": {
      "type": "object",
      "required": ["key", "label"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "secret": { "type": "boolean" },
        "env": { "type": "boolean" },
        "placeholder": { "type": "string" },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "definition": {
      "type": "object",
      "required": ["kind", "displayName", "category", "description", "capabilities", "fields"],
      "properties": {
        "kind": { "$ref": "#/$defs/kind" },
        "displayName": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "docsUrl": { "type": "string", "format": "uri" },
        "capabilities": { "$ref": "#/$defs/capabilities" },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } }
      },
      "additionalProperties": false
    },
    "instance": {
      "type": "object",
      "required": ["id", "kind", "label", "enabled", "state"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
        "kind": { "$ref": "#/$defs/kind" },
        "label": { "type": "string", "minLength": 1 },
        "enabled": { "type": "boolean" },
        "state": { "enum": ["configured", "invalid", "disabled"] },
        "root": { "type": "string" },
        "capabilities": { "$ref": "#/$defs/capabilities" },
        "errorCode": { "type": "string", "pattern": "^connector/" }
      },
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "required": ["name", "path", "kind"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["file", "folder"] },
        "size": { "type": "number", "minimum": 0 },
        "modifiedAt": { "type": "string", "format": "date-time" },
        "mimeType": { "type": "string" },
        "webUrl": { "type": "string", "format": "uri" }
      },
      "additionalProperties": false
    },
    "pullReceipt": {
      "type": "object",
      "required": ["connectorId", "kind", "path", "name", "localPath", "bytes", "sha256", "pulledAt"],
      "properties": {
        "connectorId": { "type": "string" },
        "kind": { "$ref": "#/$defs/kind" },
        "path": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "localPath": { "type": "string", "minLength": 1 },
        "bytes": { "type": "number", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "pulledAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  }
}
