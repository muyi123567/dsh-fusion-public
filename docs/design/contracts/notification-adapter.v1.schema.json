{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/muyi123567/dsh-fusion-public/docs/design/contracts/notification-adapter.v1.schema.json",
  "title": "Whale notification adapter v1",
  "oneOf": [
    { "$ref": "#/$defs/definition" },
    { "$ref": "#/$defs/status" },
    { "$ref": "#/$defs/receipt" }
  ],
  "$defs": {
    "kind": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}(/[a-z0-9][a-z0-9._-]{0,63})?$"
    },
    "eventType": { "enum": ["created", "approved", "rejected", "failed", "test"] },
    "field": {
      "type": "object",
      "required": ["key", "label"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "secret": { "type": "boolean" },
        "env": { "type": "boolean" },
        "placeholder": { "type": "string" }
      },
      "additionalProperties": false
    },
    "definition": {
      "type": "object",
      "required": ["kind", "displayName", "category", "description", "receipt", "fields"],
      "properties": {
        "kind": { "$ref": "#/$defs/kind" },
        "displayName": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "receipt": { "type": "boolean" },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } }
      },
      "additionalProperties": false
    },
    "status": {
      "type": "object",
      "required": ["id", "kind", "label", "enabled", "state", "events", "capabilities"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
        "kind": { "$ref": "#/$defs/kind" },
        "label": { "type": "string", "minLength": 1 },
        "enabled": { "type": "boolean" },
        "state": { "enum": ["configured", "invalid", "disabled"] },
        "events": { "type": "array", "items": { "$ref": "#/$defs/eventType" } },
        "capabilities": {
          "type": "object",
          "required": ["receipt"],
          "properties": { "receipt": { "type": "boolean" } },
          "additionalProperties": false
        },
        "errorCode": { "type": "string", "pattern": "^(notification/|send-result-unknown)" }
      },
      "additionalProperties": false
    },
    "receipt": {
      "type": "object",
      "required": ["adapterId", "kind", "eventType", "status", "at", "durationMs"],
      "properties": {
        "adapterId": { "type": "string", "minLength": 1 },
        "kind": { "$ref": "#/$defs/kind" },
        "eventType": { "$ref": "#/$defs/eventType" },
        "status": { "enum": ["delivered", "failed", "unknown", "skipped"] },
        "at": { "type": "string", "format": "date-time" },
        "durationMs": { "type": "number", "minimum": 0 },
        "httpStatus": { "type": "number", "minimum": 100, "maximum": 599 },
        "errorCode": { "type": "string" },
        "receipt": {
          "type": "object",
          "required": ["version"],
          "properties": {
            "version": { "type": "number" },
            "messageId": { "type": "string" },
            "conversationId": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
